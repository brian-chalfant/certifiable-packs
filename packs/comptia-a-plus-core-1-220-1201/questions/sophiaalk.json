[{"id":"sa-H1","source":"sophiaalk","type":"single","objectives":["3.4"],"prompt":"A technician upgrades a laptop for the fastest boot and app load. The board has an unused M.2 slot that supports NVMe. Which storage is best?","options":[{"id":"a","text":"SATA SSD"},{"id":"b","text":"NVMe M.2"},{"id":"c","text":"5400-rpm HDD"},{"id":"d","text":"Optical Blu-ray"}],"answer":["b"],"explanation":"NVMe over PCIe is the fastest common laptop storage","answerStatus":"verified"},{"id":"sa-H2","source":"sophiaalk","type":"single","objectives":["3.3"],"prompt":"A desktop motherboard lists support for DDR4-3200 only and already has one DDR4 stick. What is the correct upgrade path?","options":[{"id":"a","text":"Install matching DDR4 modules"},{"id":"b","text":"Install DDR5 in any empty slot"},{"id":"c","text":"Mix DDR4 and DDR5 for dual channel"},{"id":"d","text":"Use SODIMM in a desktop DIMM slot"}],"answer":["a"],"explanation":"Memory generations are not interchangeable","answerStatus":"verified"},{"id":"sa-H3","source":"sophiaalk","type":"single","objectives":["3.5"],"prompt":"You are installing a discrete graphics card on a modern board. Which slot do you use?","options":[{"id":"a","text":"PCIe x16"},{"id":"b","text":"SATA data header"},{"id":"c","text":"24-pin ATX"},{"id":"d","text":"Front-panel USB header"}],"answer":["a"],"explanation":"Discrete GPUs use PCIe x16","answerStatus":"verified"},{"id":"sa-H4","source":"sophiaalk","type":"single","objectives":["3.5","3.6"],"prompt":"A new mid-range GPU sits in PCIe x16 but monitors stay black until you add an extra cable from the PSU. What was missing?","options":[{"id":"a","text":"SATA power only"},{"id":"b","text":"4-pin Molex only"},{"id":"c","text":"Dedicated PCIe / 6+2-pin (or 12VHPWR) GPU power"},{"id":"d","text":"Front-panel HD audio"}],"answer":["c"],"explanation":"Most discrete GPUs need dedicated PSU power, not just the slot","answerStatus":"verified"},{"id":"sa-H5","source":"sophiaalk","type":"single","objectives":["3.4"],"prompt":"A workstation needs fault tolerance and has exactly two drives. Which RAID?","options":[{"id":"a","text":"RAID 0"},{"id":"b","text":"RAID 1"},{"id":"c","text":"RAID 5"},{"id":"d","text":"JBOD"}],"answer":["b"],"explanation":"Two drives + fault tolerance = RAID 1","answerStatus":"verified"},{"id":"sa-H6","source":"sophiaalk","type":"single","objectives":["3.4"],"prompt":"You need maximum write speed for a scratch disk and can accept zero fault tolerance. Which RAID?","options":[{"id":"a","text":"RAID 0"},{"id":"b","text":"RAID 1"},{"id":"c","text":"RAID 5"},{"id":"d","text":"RAID 10"}],"answer":["a"],"explanation":"RAID 0 = speed, no redundancy","answerStatus":"verified"},{"id":"sa-H7","source":"sophiaalk","type":"single","objectives":["3.4"],"prompt":"A server needs fault tolerance and has exactly three drives. Which RAID is a common fit?","options":[{"id":"a","text":"RAID 0"},{"id":"b","text":"RAID 1"},{"id":"c","text":"RAID 5"},{"id":"d","text":"JBOD"}],"answer":["c"],"explanation":"RAID 5 needs 3+ drives","answerStatus":"verified"},{"id":"sa-H8","source":"sophiaalk","type":"single","objectives":["5.6","3.8"],"prompt":"Toner looks printed but rubs off when you touch the page. Which laser part failed?","options":[{"id":"a","text":"Pickup rollers"},{"id":"b","text":"Fuser"},{"id":"c","text":"Network cable"},{"id":"d","text":"Paper-tray sensors"}],"answer":["b"],"explanation":"Toner not melted = fuser","answerStatus":"verified"},{"id":"sa-H9","source":"sophiaalk","type":"single","objectives":["5.6"],"prompt":"A laser printer feeds two or three sheets and jams near the cassette. Path looks clear. Most likely fix?","options":[{"id":"a","text":"Replace the fuser"},{"id":"b","text":"Reinstall the print driver"},{"id":"c","text":"Replace the pickup rollers"},{"id":"d","text":"Replace the imaging drum"}],"answer":["c"],"explanation":"Multi-feed at the tray = pickup rollers","answerStatus":"verified"},{"id":"sa-H10","source":"sophiaalk","type":"single","objectives":["3.4","1.1"],"prompt":"A realistic storage upgrade on most modern thin laptops is:","options":[{"id":"a","text":"Full-height PCIe GPU"},{"id":"b","text":"M.2 NVMe SSD if the board supports it"},{"id":"c","text":"Desktop DDR4 DIMMs"},{"id":"d","text":"A second PSU"}],"answer":["b"],"explanation":"Thin laptops: M.2 NVMe if supported","answerStatus":"verified"},{"id":"sa-N1","source":"sophiaalk","type":"single","objectives":["2.1"],"prompt":"A Windows PC cannot get an IP automatically. Which port/protocol should reach the server?","options":[{"id":"a","text":"TCP 389"},{"id":"b","text":"TCP 445"},{"id":"c","text":"UDP 67"},{"id":"d","text":"TCP 3389"}],"answer":["c"],"explanation":"DHCP server = UDP 67","answerStatus":"verified"},{"id":"sa-N2","source":"sophiaalk","type":"single","objectives":["2.1"],"prompt":"A help-desk tech needs remote control of a Windows desktop GUI. Which port?","options":[{"id":"a","text":"TCP 389"},{"id":"b","text":"TCP 3389"},{"id":"c","text":"TCP 445"},{"id":"d","text":"TCP 143"}],"answer":["b"],"explanation":"RDP = 3389 (LDAP is 389)","answerStatus":"verified"},{"id":"sa-N3","source":"sophiaalk","type":"single","objectives":["2.1"],"prompt":"Secure remote command-line access to a Linux server uses:","options":[{"id":"a","text":"TCP 22"},{"id":"b","text":"TCP 23"},{"id":"c","text":"TCP 443"},{"id":"d","text":"TCP 3389"}],"answer":["a"],"explanation":"SSH = 22","answerStatus":"verified"},{"id":"sa-N4","source":"sophiaalk","type":"single","objectives":["2.1"],"prompt":"Which port should you block to disable insecure Telnet?","options":[{"id":"a","text":"TCP 22"},{"id":"b","text":"TCP 23"},{"id":"c","text":"TCP 80"},{"id":"d","text":"UDP 67"}],"answer":["b"],"explanation":"Telnet = 23","answerStatus":"verified"},{"id":"sa-N5","source":"sophiaalk","type":"single","objectives":["2.1"],"prompt":"IMAP (default, unencrypted) uses:","options":[{"id":"a","text":"TCP 25"},{"id":"b","text":"TCP 110"},{"id":"c","text":"TCP 143"},{"id":"d","text":"TCP 445"}],"answer":["c"],"explanation":"IMAP = 143 (POP3 = 110)","answerStatus":"verified"},{"id":"sa-N6","source":"sophiaalk","type":"single","objectives":["2.1"],"prompt":"SMTP send (default, unencrypted) uses:","options":[{"id":"a","text":"TCP 25"},{"id":"b","text":"TCP 110"},{"id":"c","text":"TCP 443"},{"id":"d","text":"UDP 53"}],"answer":["a"],"explanation":"SMTP = 25","answerStatus":"verified"},{"id":"sa-N7","source":"sophiaalk","type":"single","objectives":["3.2"],"prompt":"Two old switches have **no** auto-MDIX. Which copper cable links them?","options":[{"id":"a","text":"Straight-through"},{"id":"b","text":"Crossover"},{"id":"c","text":"Rollover"},{"id":"d","text":"Coaxial RG-6"}],"answer":["b"],"explanation":"Same device type, no auto-MDIX = crossover","answerStatus":"verified"},{"id":"sa-N8","source":"sophiaalk","type":"single","objectives":["3.2"],"prompt":"PC to switch, modern gear with auto-MDIX. Usual copper cable?","options":[{"id":"a","text":"Straight-through"},{"id":"b","text":"Crossover"},{"id":"c","text":"Rollover"},{"id":"d","text":"Coax"}],"answer":["a"],"explanation":"PC → switch = straight-through","answerStatus":"verified"},{"id":"sa-N9","source":"sophiaalk","type":"single","objectives":["3.2"],"prompt":"Laptop serial/USB console to a Cisco-style router console port. Traditional cable type?","options":[{"id":"a","text":"Straight-through"},{"id":"b","text":"Crossover"},{"id":"c","text":"Rollover"},{"id":"d","text":"Loopback adapter"}],"answer":["c"],"explanation":"Console = rollover","answerStatus":"verified"},{"id":"sa-N10","source":"sophiaalk","type":"single","objectives":["3.2"],"prompt":"Best copper category for a new 10 Gbps run up to 100 meters?","options":[{"id":"a","text":"Cat 5"},{"id":"b","text":"Cat 5e"},{"id":"c","text":"Cat 6a"},{"id":"d","text":"Cat 3"}],"answer":["c"],"explanation":"10 Gbps @ 100 m = Cat 6a","answerStatus":"verified"},{"id":"sa-N11","source":"sophiaalk","type":"single","objectives":["3.2"],"prompt":"Cable through an air-handling drop ceiling. Required rating?","options":[{"id":"a","text":"Plenum"},{"id":"b","text":"PVC / non-plenum only"},{"id":"c","text":"Coaxial only"},{"id":"d","text":"Crossover"}],"answer":["a"],"explanation":"Air-handling space = plenum","answerStatus":"verified"},{"id":"sa-N12","source":"sophiaalk","type":"single","objectives":["2.2"],"prompt":"Open-source home-automation protocol on 2.4 GHz?","options":[{"id":"a","text":"Zigbee"},{"id":"b","text":"Bluetooth"},{"id":"c","text":"Z-Wave"},{"id":"d","text":"NFC"}],"answer":["a"],"explanation":"Zigbee = open, 2.4 GHz smart home (Z-Wave ≈ 900 MHz)","answerStatus":"verified"},{"id":"sa-M1","source":"sophiaalk","type":"single","objectives":["5.4","3.1"],"prompt":"Phone UI looks normal but touch does not register in one corner. Most likely fix?","options":[{"id":"a","text":"Replace the digitizer"},{"id":"b","text":"Calibrate the battery"},{"id":"c","text":"Replace the inverter"},{"id":"d","text":"Update the baseband"}],"answer":["a"],"explanation":"Image OK + dead touch = digitizer","answerStatus":"verified"},{"id":"sa-M2","source":"sophiaalk","type":"single","objectives":["1.2","2.2"],"prompt":"Phone pays at a terminal by tapping a few centimeters from the reader. Which tech?","options":[{"id":"a","text":"NFC"},{"id":"b","text":"Bluetooth"},{"id":"c","text":"RFID inventory only"},{"id":"d","text":"IR blaster"}],"answer":["a"],"explanation":"Tap-to-pay = NFC","answerStatus":"verified"},{"id":"sa-M3","source":"sophiaalk","type":"single","objectives":["5.4","1.2"],"prompt":"Jason's iPad died overnight on a Lightning cable that later charged his iPhone. Most likely?","options":[{"id":"a","text":"Defective charging port on the iPad"},{"id":"b","text":"Defective battery"},{"id":"c","text":"Defective Lightning cable"},{"id":"d","text":"Defective AC adapter"}],"answer":["a"],"explanation":"Same cable charges iPhone → port on the iPad","answerStatus":"verified"},{"id":"sa-M4","source":"sophiaalk","type":"single","objectives":["1.2","3.2"],"prompt":"One cable from laptop to dock must charge the laptop and drive a monitor. Which port?","options":[{"id":"a","text":"USB-C with Power Delivery"},{"id":"b","text":"HDMI"},{"id":"c","text":"VGA"},{"id":"d","text":"DVI-D"}],"answer":["a"],"explanation":"Charge + video on one cable = USB-C with PD","answerStatus":"verified"},{"id":"sa-M5","source":"sophiaalk","type":"single","objectives":["4.2"],"prompt":"Developers deploy code to a managed runtime and database; they do not manage the OS. Model?","options":[{"id":"a","text":"SaaS"},{"id":"b","text":"IaaS"},{"id":"c","text":"PaaS"},{"id":"d","text":"Community cloud"}],"answer":["c"],"explanation":"You bring code, not the OS = PaaS","answerStatus":"verified"},{"id":"sa-M6","source":"sophiaalk","type":"single","objectives":["4.2"],"prompt":"Company uses Microsoft 365 in the browser with no local servers. Model?","options":[{"id":"a","text":"IaaS"},{"id":"b","text":"PaaS"},{"id":"c","text":"SaaS"},{"id":"d","text":"Fog computing"}],"answer":["c"],"explanation":"Finished app in a browser = SaaS","answerStatus":"verified"},{"id":"sa-M7","source":"sophiaalk","type":"single","objectives":["4.2"],"prompt":"You rent VMs and install/patch the OS yourself. Model?","options":[{"id":"a","text":"SaaS"},{"id":"b","text":"PaaS"},{"id":"c","text":"IaaS"},{"id":"d","text":"DaaS"}],"answer":["c"],"explanation":"You patch the OS = IaaS","answerStatus":"verified"},{"id":"sa-M8","source":"sophiaalk","type":"single","objectives":["3.5","4.1"],"prompt":"Hypervisor installs but VMs fail with a CPU virtualization error. First fix?","options":[{"id":"a","text":"Replace the CMOS battery"},{"id":"b","text":"Enable VT-x / AMD-V in BIOS/UEFI"},{"id":"c","text":"Install more USB hubs"},{"id":"d","text":"Switch to HDD only"}],"answer":["b"],"explanation":"Hardware virtualization must be enabled in firmware","answerStatus":"verified"},{"id":"sa-T3","source":"sophiaalk","type":"single","objectives":["5.5","2.6"],"prompt":"PC has IP 169.254.12.88 and limited/no connectivity. Most likely?","options":[{"id":"a","text":"DNS server is down"},{"id":"b","text":"DHCP lease failed"},{"id":"c","text":"Default gateway is wrong"},{"id":"d","text":"The NIC is disabled"}],"answer":["b"],"explanation":"169.254 = APIPA = no DHCP","answerStatus":"verified"},{"id":"sa-T4","source":"sophiaalk","type":"single","objectives":["5.5","2.4"],"prompt":"User can ping 8.8.8.8 but cannot open websites by name. Most likely?","options":[{"id":"a","text":"Bad default gateway"},{"id":"b","text":"DNS problem"},{"id":"c","text":"DHCP failure (APIPA)"},{"id":"d","text":"Failed RAID controller"}],"answer":["b"],"explanation":"IP works, names fail = DNS","answerStatus":"verified"},{"id":"sa-T5","source":"sophiaalk","type":"single","objectives":["5.5"],"prompt":"PC pings other hosts on 192.168.1.0/24 but cannot ping 8.8.8.8. Most likely?","options":[{"id":"a","text":"DNS"},{"id":"b","text":"DHCP"},{"id":"c","text":"Default gateway / routing"},{"id":"d","text":"SMB share permissions"}],"answer":["c"],"explanation":"On-LAN works, off-subnet fails = gateway","answerStatus":"verified"},{"id":"sa-T6","source":"sophiaalk","type":"single","objectives":["5.1"],"prompt":"Desktop POST: continuous beeps, no video. Monitor and cable work on another PC. Best next step?","options":[{"id":"a","text":"Replace the CMOS battery"},{"id":"b","text":"Reseat the RAM"},{"id":"c","text":"Update the BIOS"},{"id":"d","text":"Replace the PSU"}],"answer":["b"],"explanation":"Beep + no video, known-good display → RAM","answerStatus":"verified"},{"id":"sa-T7","source":"sophiaalk","type":"single","objectives":["1.1","5.5"],"prompt":"After a laptop screen replacement, Wi-Fi range is suddenly terrible. Ethernet is fine. Most likely?","options":[{"id":"a","text":"Replace the LCD again"},{"id":"b","text":"Reseat or replace Wi-Fi antennas in the display bezel"},{"id":"c","text":"Replace the CMOS battery"},{"id":"d","text":"Reinstall the OS"}],"answer":["b"],"explanation":"Antennas live in the display assembly","answerStatus":"verified"},{"id":"sa-T8","source":"sophiaalk","type":"single","objectives":["5.3","3.1"],"prompt":"Older CCFL laptop: built-in LCD is extremely dim; external monitor is normal. Likely part?","options":[{"id":"a","text":"Digitizer"},{"id":"b","text":"Inverter"},{"id":"c","text":"Wi-Fi antenna"},{"id":"d","text":"CMOS battery"}],"answer":["b"],"explanation":"CCFL dim + external OK = inverter","answerStatus":"verified"},{"id":"sa-T9","source":"sophiaalk","type":"single","objectives":["5.3"],"prompt":"Conference projector shuts off after a few minutes, then works after cooling. Best first action?","options":[{"id":"a","text":"Replace the HDMI cable"},{"id":"b","text":"Clean or replace the air filter / check overheating"},{"id":"c","text":"Lower the resolution"},{"id":"d","text":"Update the GPU driver"}],"answer":["b"],"explanation":"Heat-cycle shutdown = airflow / filter","answerStatus":"verified"},{"id":"sa-T10","source":"sophiaalk","type":"single","objectives":["5.6"],"prompt":"Several users' jobs stuck on a shared Windows print server; printer prints its own test page. Best next step?","options":[{"id":"a","text":"Restart the print spooler"},{"id":"b","text":"Replace the toner"},{"id":"c","text":"Change paper size in the app"},{"id":"d","text":"Update motherboard BIOS"}],"answer":["a"],"explanation":"Local test page OK = Windows spooler","answerStatus":"verified"},{"id":"sa-T11","source":"sophiaalk","type":"single","objectives":["5.6","3.7"],"prompt":"You connected a new wireless printer to the **guest** SSID. Workstation is on corporate Wi-Fi. Test page does not print. Most likely?","options":[{"id":"a","text":"Guest network isolation — printer should be on the corporate WLAN"},{"id":"b","text":"DHCP is disabled on the workstation"},{"id":"c","text":"Workstation is not a print server"},{"id":"d","text":"IPP was not configured"}],"answer":["a"],"explanation":"Guest WLAN is isolated from corporate","answerStatus":"verified"},{"id":"sa-T12","source":"sophiaalk","type":"single","objectives":["5.6"],"prompt":"Repeating smudge/spot at regular intervals on every laser page. Usual suspect?","options":[{"id":"a","text":"Fuser"},{"id":"b","text":"Pickup rollers"},{"id":"c","text":"Imaging drum"},{"id":"d","text":"Duplexer"}],"answer":["c"],"explanation":"Repeating marks ≈ drum circumference","answerStatus":"verified"},{"id":"sa-C1","source":"sophiaalk","type":"single","objectives":["3.2"],"prompt":"Which connector terminates a standard Cat 6 Ethernet patch cable?","options":[{"id":"a","text":"RJ11"},{"id":"b","text":"RJ45"},{"id":"c","text":"F-type"},{"id":"d","text":"Molex"}],"answer":["b"],"explanation":"Ethernet = RJ45","answerStatus":"verified"},{"id":"sa-C2","source":"sophiaalk","type":"single","objectives":["3.2"],"prompt":"Common fiber patch-cable connector?","options":[{"id":"a","text":"RJ45"},{"id":"b","text":"LC"},{"id":"c","text":"DB-9"},{"id":"d","text":"USB-A"}],"answer":["b"],"explanation":"LC (also SC, ST)","answerStatus":"verified"},{"id":"sa-C3","source":"sophiaalk","type":"single","objectives":["3.2"],"prompt":"Two offices are 3 km apart. Fiber with the least attenuation?","options":[{"id":"a","text":"Multimode"},{"id":"b","text":"Single-mode"},{"id":"c","text":"Cat 6a"},{"id":"d","text":"RG-59"}],"answer":["b"],"explanation":"Kilometers = single-mode","answerStatus":"verified"},{"id":"sa-C4","source":"sophiaalk","type":"single","objectives":["3.2"],"prompt":"Short in-building fiber (~80 m) IDF to MDF. Most common type?","options":[{"id":"a","text":"Single-mode"},{"id":"b","text":"Multimode"},{"id":"c","text":"Cat 3"},{"id":"d","text":"RG-6"}],"answer":["b"],"explanation":"Short building run = multimode","answerStatus":"verified"},{"id":"sa-C5","source":"sophiaalk","type":"single","objectives":["2.8"],"prompt":"RJ45 on the end of a patch cable — which tool?","options":[{"id":"a","text":"Punchdown"},{"id":"b","text":"Crimper"}],"answer":["b"],"explanation":"Patch cord plug = crimper","answerStatus":"verified"},{"id":"sa-C6","source":"sophiaalk","type":"single","objectives":["2.8"],"prompt":"Terminating Cat 6 into a wall keystone jack — which tool?","options":[{"id":"a","text":"Punchdown"},{"id":"b","text":"Crimper"},{"id":"c","text":"Tone generator + probe"},{"id":"d","text":"Loopback"}],"answer":["a"],"explanation":"Keystone / panel = punchdown","answerStatus":"verified"},{"id":"sa-C7","source":"sophiaalk","type":"single","objectives":["2.8"],"prompt":"Find which closet cable goes to desk 14. Best tool?","options":[{"id":"a","text":"Cable tester"},{"id":"b","text":"Punchdown"},{"id":"c","text":"Tone generator and probe"},{"id":"d","text":"Crimper"}],"answer":["c"],"explanation":"Identify a drop = toner + probe","answerStatus":"verified"},{"id":"sa-C8","source":"sophiaalk","type":"single","objectives":["3.2"],"prompt":"Classic VGA resolution and signal type?","options":[{"id":"a","text":"640×480 analog"},{"id":"b","text":"800×600 digital"},{"id":"c","text":"1024×768 DisplayPort"},{"id":"d","text":"1920×1080 HDMI only"}],"answer":["a"],"explanation":"VGA = 640×480 analog","answerStatus":"verified"}]
